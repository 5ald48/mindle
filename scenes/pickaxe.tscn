[sub_resource type="GDScript" id="GDScript_riqys"]
script/source = "extends Node2D

var current_tween: Tween
var btn_pickaxe_level_upgrade : Node
var btn_pickaxe_click_power : Node
var btn_upgrade_multiplyer : Node

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	
	btn_pickaxe_level_upgrade = $\"../Control/pickaxe level upgrade\"
	btn_pickaxe_click_power = $\"../Control2/pickaxe click upgrade\"
	btn_upgrade_multiplyer = $\"../Control3/upgrade multiplayer\"



# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:

	if not btn_pickaxe_level_upgrade.is_hovered():
		current_tween = create_tween()
		current_tween.tween_property(btn_pickaxe_level_upgrade,\"scale\",Vector2(1.0 ,1.0),0.1)


	if not btn_pickaxe_click_power.is_hovered():
		current_tween = create_tween()
		current_tween.tween_property(btn_pickaxe_click_power,\"scale\",Vector2(1.0 ,1.0),0.1)


	if not btn_upgrade_multiplyer.is_hovered():
		current_tween = create_tween()

		current_tween.tween_property(btn_upgrade_multiplyer,\"scale\",Vector2(1.0 ,1.0),0.1)


func _on_upgrade_multiplayer_pressed() -> void:
	if current_tween: current_tween.kill()
	current_tween = create_tween()
	current_tween.tween_property(btn_upgrade_multiplyer,\"scale\",Vector2(0.9 ,0.6),0.1)
	current_tween.tween_property(btn_upgrade_multiplyer,\"scale\",Vector2(1.5 ,1.5),0.1)



func _on_upgrade_multiplayer_mouse_entered() -> void:
	if current_tween: current_tween.kill()
	current_tween = create_tween()
	current_tween.tween_property(btn_upgrade_multiplyer,\"scale\",Vector2(1.5 ,1.5),0.1)









func _on_pickaxe_click_upgrade_pressed() -> void:
	if current_tween: current_tween.kill()
	current_tween = create_tween()
	current_tween.tween_property(btn_pickaxe_click_power,\"scale\",Vector2(0.9 ,0.6),0.1)
	current_tween.tween_property(btn_pickaxe_click_power,\"scale\",Vector2(1.5 ,1.5),0.1)



func _on_pickaxe_click_upgrade_mouse_entered() -> void:
	if current_tween: current_tween.kill()
	current_tween = create_tween()
	current_tween.tween_property(btn_pickaxe_click_power,\"scale\",Vector2(1.5 ,1.5),0.1)









func _on_pickaxe_level_upgrade_pressed() -> void:
	if current_tween: current_tween.kill()
	current_tween = create_tween()
	current_tween.tween_property(btn_pickaxe_level_upgrade,\"scale\",Vector2(0.9 ,0.6),0.1)
	current_tween.tween_property(btn_pickaxe_level_upgrade,\"scale\",Vector2(1.5 ,1.5),0.1)



func _on_pickaxe_level_upgrade_mouse_entered() -> void:
	if current_tween: current_tween.kill()
	current_tween = create_tween()
	current_tween.tween_property(btn_pickaxe_level_upgrade,\"scale\",Vector2(1.5 ,1.5),0.1)
"

[sub_resource type="GDScript" id="GDScript_bhunq"]
script/source = "extends TextureButton


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	$\"../spritee/RichTextLabel\".text = \" upgrade  multiplyer  \\n     =          \" + Gamedata.per_sec_multiplier.to_metric_name(false) + \" \"
	$RichTextLabel2.text = \"  \" + Gamedata.per_sec_multiplier_cost.to_metric_name(true) + \"  \"


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:
	pass


func _on_pressed() -> void:
	if Gamedata.pristage_coin.is_greater_than_or_equal_to(Gamedata.per_sec_multiplier_cost):
		Gamedata.pristage_coin.minus_equals(Gamedata.per_sec_multiplier_cost)
		Gamedata.per_sec_multiplier.multiply_equals(Gamedata.per_sec_multiplier_multiplier)
		Gamedata.per_sec_multiplier_cost.multiply_equals(Gamedata.per_sec_multiplier_cost_multiplier)
		$\"../spritee/RichTextLabel\".text = \" upgrade multiplyer = \" + Gamedata.per_sec_multiplier.to_metric_name(false) + \" \"
		$RichTextLabel2.text = \" \" + Gamedata.per_sec_multiplier_cost.to_metric_name(true) + \" \"
"

