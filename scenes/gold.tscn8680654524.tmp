[sub_resource type="GDScript" id="GDScript_egmlc"]
script/source = "extends RichTextLabel


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:
	text = Gamedata.gold_miner_upgrade_cost.to_metric_name(true)
"

[sub_resource type="GDScript" id="GDScript_kmql5"]
script/source = "extends TextureButton

@export var texture_on : Texture2D
@export var texture_off : Texture2D

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:
	if Gamedata.gold_miner_on_off == true :
		texture_normal = texture_on
	
	elif  Gamedata.gold_miner_on_off == false:
		texture_normal = texture_off



func _on_pressed() -> void:
	if Gamedata.gold_miner_unlocked == true :
		
		if Gamedata.gold_miner_on_off == false :
			Gamedata.gold_miner_on_off = true
			
		
		
		elif Gamedata.gold_miner_on_off == true :
			Gamedata.gold_miner_on_off = false
			
"

