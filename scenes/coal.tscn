[sub_resource type="GDScript" id="GDScript_y2yhy"]
script/source = "extends RichTextLabel


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:
	text = Gamedata.coal_miner_upgrade_cost.to_metric_name(true)
"

[sub_resource type="GDScript" id="GDScript_uhxyx"]
script/source = "extends TextureButton

@export var texture_on : Texture2D
@export var texture_off : Texture2D

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:
	if Gamedata.coal_miner_on_off == true :
		texture_normal = texture_on
	
	elif  Gamedata.coal_miner_on_off == false:
		texture_normal = texture_off



func _on_pressed() -> void:
	if Gamedata.coal_miner_unlocked == true :
		
		if Gamedata.coal_miner_on_off == false :
			Gamedata.coal_miner_on_off = true
			
		
		
		elif Gamedata.coal_miner_on_off == true :
			Gamedata.coal_miner_on_off = false
			
"

